# Copy to .env on the VPS (`cp .env.example .env && chmod 600 .env`).
# .env is gitignored and must never be committed. Back up its CONTENTS
# somewhere off the VPS the moment it's written (a password manager entry) -
# losing this file means regenerating every credential below.
#
# Used by deploy/docker-compose.yml. Generate real passwords with, e.g.:
#   openssl rand -base64 24

# --- Postgres roles (see postgres-init/01-init-databases.sh) ---
POSTGRES_SUPERUSER_PASSWORD=
ORDERING_APP_PASSWORD=
WAREHOUSE_APP_PASSWORD=
ORDERING_READER_PASSWORD=

# --- Ordering backend (dhaka-kacchi-connect/worker) ---
# DATABASE_URL is composed automatically in docker-compose.yml from
# ORDERING_APP_PASSWORD above - do not set it here.
ALLOWED_ORIGINS=https://dhakakacchi.de,https://www.dhakakacchi.de
ORDER_FROM_EMAIL=orders@dhakakacchi.de

HOSTINGER_SMTP_HOST=smtp.hostinger.com
HOSTINGER_SMTP_PORT=465
HOSTINGER_SMTP_USER=orders@dhakakacchi.de
HOSTINGER_SMTP_PASS=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
ARKO_WHATSAPP_TO=

# --- Warehouse (this repo) ---
# DATABASE_URL and ORDERING_DATABASE_URL are composed automatically in
# docker-compose.yml - do not set them here.
WAREHOUSE_ECHO_SQL=0
