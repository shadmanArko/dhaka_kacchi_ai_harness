# Copy to .env (`make env` does this and substitutes your username).
# .env is gitignored. Real env vars always win over .env - see warehouse/config.py.
#
# Scheme MUST be postgresql:// (not postgres://). Leave the driver off: config.py
# normalises to postgresql+psycopg:// for SQLAlchemy, so this value stays usable
# by psql, pgcli and the ingest jobs as-is.
DATABASE_URL=postgresql://YOUR_USER@127.0.0.1:5432/dhaka_kacchi

# Set to 1 to echo every SQL statement.
WAREHOUSE_ECHO_SQL=0

# Ingestion: direct channel, see warehouse/ingest/direct.py. Points at the
# ordering backend's own Postgres database (dhaka-kacchi-connect/worker) -
# same validation rules as DATABASE_URL (postgresql://, sslmode required for
# a non-local host). On the VPS this connects as the read-only
# `ordering_reader` role, never `ordering_app`.
ORDERING_DATABASE_URL=postgresql://YOUR_USER@127.0.0.1:5432/ordering

# Ingestion: instagram channel, see warehouse/ingest/instagram.py. Meta Graph
# API credentials, not a Postgres connection string - a long-lived access
# token for the Instagram Business Account, and that account's own id (not
# its @username). Requires a Meta Developer App with Instagram Graph API
# access - see that module's docstring for full setup steps, including the
# App Review lead time.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Ingestion: facebook channel, see warehouse/ingest/facebook.py. A Page
# Access Token (not a User Token) and that Page's own id - requires
# pages_read_engagement, pages_read_user_content, and read_insights.
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# Ingestion: threads channel, see warehouse/ingest/threads.py. A genuinely
# separate credential from the two above - Threads has its own App ID/
# Secret and its own token-issuing host (graph.threads.net). A long-lived
# token from the app's "Access the Threads API" use case (Settings tab ->
# User Token Generator), 60-day validity, refreshable - not non-expiring
# like the Facebook Page token. THREADS_USER_ID is the numeric Threads user
# id, not the @username.
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
