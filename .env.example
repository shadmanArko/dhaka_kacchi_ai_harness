# Copy to .env (`make env` does this and substitutes your username).
# .env is gitignored. Real env vars always win over .env - see warehouse/config.py.
#
# Scheme MUST be postgresql:// (not postgres://). Leave the driver off: config.py
# normalises to postgresql+psycopg:// for SQLAlchemy, so this value stays usable
# by psql, pgcli and the ingest jobs as-is.
DATABASE_URL=postgresql://YOUR_USER@127.0.0.1:5432/dhaka_kacchi

# Set to 1 to echo every SQL statement.
WAREHOUSE_ECHO_SQL=0

# Ingestion: direct channel, see warehouse/ingest/direct.py. Points at the
# ordering backend's own Postgres database (dhaka-kacchi-connect/worker) -
# same validation rules as DATABASE_URL (postgresql://, sslmode required for
# a non-local host). On the VPS this connects as the read-only
# `ordering_reader` role, never `ordering_app`.
ORDERING_DATABASE_URL=postgresql://YOUR_USER@127.0.0.1:5432/ordering

# Ingestion: instagram channel, see warehouse/ingest/instagram.py. Meta Graph
# API credentials, not a Postgres connection string - a long-lived access
# token for the Instagram Business Account, and that account's own id (not
# its @username). Requires a Meta Developer App with Instagram Graph API
# access - see that module's docstring for full setup steps, including the
# App Review lead time.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Ingestion: facebook channel, see warehouse/ingest/facebook.py. A Page
# Access Token (not a User Token) and that Page's own id - requires
# pages_read_engagement, pages_read_user_content, and read_insights.
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# Ingestion: threads channel, see warehouse/ingest/threads.py. A genuinely
# separate credential from the two above - Threads has its own App ID/
# Secret and its own token-issuing host (graph.threads.net). A long-lived
# token from the app's "Access the Threads API" use case (Settings tab ->
# User Token Generator), 60-day validity, refreshable - not non-expiring
# like the Facebook Page token. THREADS_USER_ID is the numeric Threads user
# id, not the @username.
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# ops/refresh_social_share.py: writes into `social_share`, a SEPARATE
# database (not a schema in `warehouse`) holding a decoupled, read-only
# copy of social post performance data for an outside collaborator - see
# deploy/CLAUDE.md's "Social share database" section. Must connect as the
# social_share_writer role, never warehouse_app. Local dev doesn't need
# this unless you're working on the refresh job itself.
SOCIAL_SHARE_DATABASE_URL=postgresql://YOUR_USER@127.0.0.1:5432/social_share

# ---------------------------------------------------------------------------
# RAG subsystem (rag/). Four roles, not one per table - a role answers "who is
# asking", never "what are they asking for". See rag/MULTI_STORE_DESIGN.md
# section 6 for the model, and rag/RAG_System_Guide.md part 4 for the full
# setup order.
#
# The three role passwords are GENERATED by `uv run python -m rag.bootstrap_db`
# and printed once, at creation. Postgres stores only a hash, so if that
# printout is lost the only recovery is `ALTER ROLE ... PASSWORD`, not
# retrieving the original.
#
# WHICH stores exist, what each is called, and which are public or internal is
# NOT configured here - that lives in rag/stores.toml, next to the code that
# reads it. This file only carries credentials.
# ---------------------------------------------------------------------------

# One-time setup only (rag/bootstrap_db.py, rag/schema.py). Deliberately
# points at the `postgres` MAINTENANCE database, because dhaka_kacchi_rag does
# not exist yet the first time it runs - this is the one variable whose loader
# permits a maintenance database.
RAG_ADMIN_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5434/postgres

# The recurring ingestion job (both loaders, and rag/reindex.py): needs
# SELECT/INSERT/UPDATE/DELETE on every store table, and no DDL at all.
RAG_WRITER_DATABASE_URL=postgresql://rag_writer:YOUR_PASSWORD@127.0.0.1:5434/dhaka_kacchi_rag

# A caller that may read PUBLIC stores only. This is the credential a
# customer-facing process (e.g. a chatbot) runs with. It cannot read any store
# marked "internal", and that is enforced by Postgres grants rather than by
# application code - `uv run python -m rag.verify_stores` checks the two agree.
RAG_PUBLIC_READER_DATABASE_URL=postgresql://rag_public_reader:YOUR_PASSWORD@127.0.0.1:5434/dhaka_kacchi_rag

# A caller that may read EVERY store. Used by the business's own agents and by
# the local web UI. It is a Postgres MEMBER of the public reader role, so it
# inherits every public-store grant automatically.
RAG_INTERNAL_READER_DATABASE_URL=postgresql://rag_internal_reader:YOUR_PASSWORD@127.0.0.1:5434/dhaka_kacchi_rag

# LEGACY: the single pre-multi-store reader role, which could read the one
# `chunks` table (holding both corpora). Needed only while that table is still
# in use; retired together with it once the migration completes.
RAG_READER_DATABASE_URL=postgresql://rag_reader:YOUR_PASSWORD@127.0.0.1:5434/dhaka_kacchi_rag
